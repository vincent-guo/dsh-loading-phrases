{
  "name": "dsh-loading-phrases",
  "version": "0.6.3",
  "description": "Replace the 'Deep diving...' running status in the DeepSeek Harness Web GUI with alternating witty phrases and practical tips.",
  "author": "vincent-guo <vincent.weiguo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincent-guo/dsh-loading-phrases.git"
  },
  "homepage": "https://github.com/vincent-guo/dsh-loading-phrases#readme",
  "bugs": {
    "url": "https://github.com/vincent-guo/dsh-loading-phrases/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "web-gui",
    "loading",
    "phrases",
    "plugin",
    "profile-bundle"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-data.js",
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "node scripts/test-manifest.mjs && node scripts/test-client.mjs && node scripts/test-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
